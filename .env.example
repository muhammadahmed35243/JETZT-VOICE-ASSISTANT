# --- Telnyx ---
# Same account as the existing dialer (see docs/what-already-done-in-dialer.md).
# This is a NEW Call Control connection, separate from the dialer's TeXML
# "Cold Dialer" connection — create it in the Telnyx portal (Voice > Connections
# > Call Control) and assign +12137580964's INBOUND routing to it. Outbound
# routing for the dialer is unaffected (it passes its own connection id
# per-call).
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_PHONE_NUMBER=+12137580964
TELNYX_CALL_CONTROL_CONNECTION_ID=

# --- Deepgram ---
DEEPGRAM_API_KEY=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Supabase ---
# The dialer's own Supabase project (bxtmcelkwglvidkcmgkp) — shared
# database between the two repos, not a separate project. Service-role key
# is server-side only, never exposed to a client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional — direct Postgres connection string, only for the LangGraph
# checkpointer. See README "Setup" for the tradeoff of leaving this unset.
SUPABASE_DB_URL=

# --- Google Calendar (meeting booking) ---
# Same OAuth app as the JETZT portal (copy its GOOGLE_CALENDAR_CLIENT_ID /
# GOOGLE_CALENDAR_CLIENT_SECRET), plus a refresh token for the company
# Google account, scope calendar.events. Leave unset to disable booking —
# the agent takes a message instead.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# Bookable hours, in BOOKING_TIMEZONE. Defaults shown.
BOOKING_TIMEZONE=America/Los_Angeles
BOOKING_HOURS=09:00-17:00
# 0 = Sunday. "1-5" = Monday to Friday, or a list like "1,2,4".
BOOKING_DAYS=1-5
BOOKING_SLOT_MINUTES=30
BOOKING_MIN_NOTICE_MINUTES=120

# --- App ---
# A stable custom domain (not Vercel's per-deployment URL) this service is
# reachable at, for Telnyx's webhook callbacks and the media-stream URL.
PUBLIC_BASE_URL=
