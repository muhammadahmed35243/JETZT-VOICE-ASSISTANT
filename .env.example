# --- Telnyx ---
# Same account as the existing dialer (see docs/what-already-done-in-dialer.md).
# This is a NEW Call Control connection, separate from the dialer's TeXML
# "Cold Dialer" connection — create it in the Telnyx portal (Voice > Connections
# > Call Control) and assign +12137580964's INBOUND routing to it. Outbound
# routing for the dialer is unaffected (it passes its own connection id
# per-call).
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_PHONE_NUMBER=+12137580964
TELNYX_CALL_CONTROL_CONNECTION_ID=

# --- Deepgram ---
DEEPGRAM_API_KEY=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Supabase ---
# Service-role key (server-side only, never exposed to a client).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, for the LangGraph checkpointer.
SUPABASE_DB_URL=

# --- Calendly ---
# Pending — see docs/voice-agent-plan.md Pre-build checklist.
# Requires a paid Calendly plan for the Scheduling API.
CALENDLY_API_KEY=
CALENDLY_EVENT_TYPE_URI=

# --- App ---
PORT=8080
# Public base URL this service is reachable at, for Telnyx webhook callbacks.
PUBLIC_BASE_URL=
